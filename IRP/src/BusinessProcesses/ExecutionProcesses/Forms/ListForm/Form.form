    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT 
       ExecutionProcesses.Ref, 
       ExecutionProcesses.DeletionMark, 
       ExecutionProcesses.Number, 
       ExecutionProcesses.Date, 
       ExecutionProcesses.Completed, 
       ExecutionProcesses.HeadTask, 
       ExecutionProcesses.Started, 
       ExecutionProcesses.Template, 
       ExecutionProcesses.ExecutionObject, 
       ExecutionProcesses.CompletionDate, 
