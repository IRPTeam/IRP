       ExecutionProcesses.Description_hash, 
       ExecutionProcesses.CreateDate, 
       ExecutionProcesses.Author, 
       ExecutionProcesses.ModifyDate, 
       ExecutionProcesses.Description_en AS Description, 
       ExecutionProcesses.Comment
 FROM 
       BusinessProcess.ExecutionProcesses
 AS 
       ExecutionProcesses</queryText>
      <mainTable>BusinessProcess.ExecutionProcesses</mainTable>
