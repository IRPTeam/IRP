  <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
   <segments>List.Vendor</segments>
  </notDefaultUseAlwaysAttributes>
  <main>true</main>
  <extInfo xsi:type="form:DynamicListExtInfo">
   <queryText>SELECT
	Table.Ref,
	Table.DeletionMark,
	Table.Customer,
	Table.Vendor,
	Table.Employee,
	Table.Predefined,
	Table.PredefinedDataName,
	Table.LocalFullDescription,
	Table.MainPhoneNumber,
	Table.Email,
	Table.Description_en AS Description,
	Table.Code
FROM
	Catalog.Partners AS Table
WHERE
	CASE
		WHEN &amp;FilterPartnersByCompanies
			THEN Table.Ref IN (&amp;PartnersByCompanies)
		ELSE TRUE
	END</queryText>
   <mainTable>Catalog.Partners</mainTable>
