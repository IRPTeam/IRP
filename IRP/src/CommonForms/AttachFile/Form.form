    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	AttachedFiles.Owner AS Owner,
	AttachedFiles.File AS File,
	AttachedFiles.Priority AS Priority,
	AttachedFiles.CreationDate AS CreationDate,
	AttachedFiles.File.Extension AS FileExtension
FROM
	InformationRegister.AttachedFiles AS AttachedFiles
WHERE
	AttachedFiles.Owner = &amp;Owner</queryText>
