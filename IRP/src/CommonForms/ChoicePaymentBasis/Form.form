  </edit>
  <main>true</main>
  <extInfo xsi:type="form:DynamicListExtInfo">
   <queryText>SELECT DISTINCT
	Table.Ref AS Document,
	Table.Company AS Company,
	Table.Branch AS Branch,
	Table.Partner AS Partner,
	Table.Agreement AS Agreement,
	Table.LegalName AS LegalName
INTO tmp
FROM
	Document.SalesReportFromTradeAgent AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;SalesReportFromTradeAgent

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	NULL,
	NULL,
	NULL
FROM
	Document.CashTransferOrder AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND &amp;CashTransferOrder

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Ref.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.DebitNote.Transactions AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Ref.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;DebitNote

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Ref.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.CreditNote.Transactions AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Ref.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;CreditNote

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.PurchaseInvoice AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;PurchaseInvoice

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.SalesInvoice AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;SalesInvoice

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.SalesReturn AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;SalesReturn

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.PurchaseReturn AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;PurchaseReturn

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.RetailSalesReceipt AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;RetailSalesReceipt

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.RetailReturnReceipt AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;RetailReturnReceipt

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.SalesReportToConsignor AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;SalesReportToConsignor

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.WithholdingTaxInvoice AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;WithholdingTaxInvoice

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.PartnerTradeAgent,
	Table.AgreementTradeAgent,
	Table.LegalNameTradeAgent
FROM
	Document.OpeningEntry AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Branch = &amp;Branch
	AND Table.PartnerTradeAgent = &amp;Partner
	AND Table.AgreementTradeAgent = &amp;Agreement
	AND Table.LegalNameTradeAgent = &amp;LegalName
	AND &amp;OpeningEntry_TradeAgent

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Branch,
	Table.PartnerConsignor,
	Table.AgreementConsignor,
	Table.LegalNameConsignor
FROM
	Document.OpeningEntry AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.PartnerConsignor = &amp;Partner
	AND Table.AgreementConsignor = &amp;Agreement
	AND Table.LegalNameConsignor = &amp;LegalName
	AND &amp;OpeningEntry_Consignor

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Ref.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.OpeningEntry.AccountPayableByDocuments AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Ref.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;OpeningEntry_AccountPayable

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Ref.Branch,
	Table.Partner,
	Table.Agreement,
	Table.LegalName
FROM
	Document.OpeningEntry.AccountReceivableByDocuments AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Ref.Branch = &amp;Branch
	AND Table.Partner = &amp;Partner
	AND Table.Agreement = &amp;Agreement
	AND Table.LegalName = &amp;LegalName
	AND &amp;OpeningEntry_AccountReceivable
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	tmp.Document,
	tmp.Company,
	tmp.Branch,
	tmp.Partner,
	tmp.Agreement,
	tmp.LegalName,
	R5020B_PartnersBalanceBalance.Currency,
	CASE
		WHEN ISNULL(R5020B_PartnersBalanceBalance.AmountBalance, 0) &lt; 0
			THEN -ISNULL(R5020B_PartnersBalanceBalance.AmountBalance, 0)
		ELSE ISNULL(R5020B_PartnersBalanceBalance.AmountBalance, 0)
	END AS Amount
FROM
	tmp AS tmp
		LEFT JOIN AccumulationRegister.R5020B_PartnersBalance.Balance(&amp;Period, (Company, Branch, Partner, Agreement,
			LegalName, Document) IN
			(SELECT
				tmp.Company,
				tmp.Branch,
				tmp.Partner,
				tmp.Agreement,
				tmp.LegalName,
				tmp.Document
			FROM
				tmp AS tmp)
		AND CurrencyMovementType = VALUE(ChartOfCharacteristicTypes.CurrencyMovementType.SettlementCurrency)) AS
			R5020B_PartnersBalanceBalance
		ON tmp.Company = R5020B_PartnersBalanceBalance.Company
		AND tmp.Branch = R5020B_PartnersBalanceBalance.Branch
		AND tmp.Partner = R5020B_PartnersBalanceBalance.Partner
		AND tmp.Agreement = R5020B_PartnersBalanceBalance.Agreement
		AND tmp.LegalName = R5020B_PartnersBalanceBalance.LegalName
		AND tmp.Document = R5020B_PartnersBalanceBalance.Document</queryText>
