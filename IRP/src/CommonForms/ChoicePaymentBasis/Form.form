 <attributes>
  <name>List</name>
  <title>
   <key>tr</key>
   <value>Liste</value>
  </title>
  <title>
   <key>ru</key>
   <value>Список</value>
  </title>
  <title>
   <key>en</key>
   <value>List</value>
  </title>
  <id>1</id>
  <valueType>
   <types>DynamicList</types>
  </valueType>
  <view>
