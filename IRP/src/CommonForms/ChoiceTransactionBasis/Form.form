  <extInfo xsi:type="form:DynamicListExtInfo">
   <queryText>SELECT DISTINCT
	Table.Ref AS Document,
	Table.Company AS Company,
	Table.Partner AS Partner,
	Table.LegalName AS LegalName,
	Table.Agreement AS Agreement
FROM
	Document.SalesReportFromTradeAgent AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND Table.LegalName = &amp;LegalName
	AND Table.Agreement = &amp;Agreement
	AND &amp;SalesReportFromTradeAgent

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	NULL,
	NULL,
	NULL
FROM
	Document.CashTransferOrder AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND &amp;CashTransferOrder

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner,
	Table.LegalName,
	Table.Agreement
FROM
	Document.DebitNote.Transactions AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND Table.LegalName = &amp;LegalName
	AND Table.Agreement = &amp;Agreement
	AND &amp;DebitNote

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner,
