    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT DISTINCT
	Table.Ref AS Document,
	Table.Company AS Company,
	Table.Partner AS Partner
FROM
	Document.SalesReportFromTradeAgent AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;SalesReportFromTradeAgent

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	NULL
FROM
	Document.CashTransferOrder AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND &amp;CashTransferOrder

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.DebitNote.Transactions AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;DebitNote

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.CreditNote.Transactions AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;CreditNote

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.PurchaseInvoice AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;PurchaseInvoice

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.PurchaseOrder AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;PurchaseOrder
	AND &amp;IsOrder

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.SalesInvoice AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;SalesInvoice

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.SalesOrder AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;SalesOrder
	AND &amp;IsOrder

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.SalesReturn AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;SalesReturn

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.PurchaseReturn AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;PurchaseReturn

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.RetailSalesReceipt AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;RetailSalesReceipt

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.RetailReturnReceipt AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;RetailReturnReceipt

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.EmployeeCashAdvance AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;EmployeeCashAdvance

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.SalesReportToConsignor AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;SalesReportToConsignor

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.Partner
FROM
	Document.WithholdingTaxInvoice AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;WithholdingTaxInvoice

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.PartnerTradeAgent
FROM
	Document.OpeningEntry AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.PartnerTradeAgent = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Company,
	Table.PartnerConsignor
FROM
	Document.OpeningEntry AS Table
WHERE
	Table.Posted
	AND Table.Company = &amp;Company
	AND Table.PartnerConsignor = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AdvanceFromCustomers AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AdvanceToSuppliers AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AccountPayableByAgreements AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AccountPayableByDocuments AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AccountReceivableByDocuments AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AccountReceivableByAgreements AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Employee
FROM
	Document.OpeningEntry.EmployeeCashAdvance AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Employee = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AccountReceivableOther AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry

UNION

SELECT DISTINCT
	Table.Ref,
	Table.Ref.Company,
	Table.Partner
FROM
	Document.OpeningEntry.AccountPayableOther AS Table
WHERE
	Table.Ref.Posted
	AND Table.Ref.Company = &amp;Company
	AND Table.Partner = &amp;Partner
	AND &amp;OpeningEntry</queryText>
