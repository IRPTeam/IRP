   </fields>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>Editor</dataPath>
    <field>Editor</field>
   </fields>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>Locked</dataPath>
