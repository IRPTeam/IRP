    <dataPath>Period</dataPath>
    <field>Period</field>
   </fields>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>Recorder</dataPath>
    <field>Recorder</field>
   </fields>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>LastDocumentPointPresentation</dataPath>
    <field>LastDocumentPointPresentation</field>
    <title>
     <localValue>
      <content>
