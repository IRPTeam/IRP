 <attributes>
  <name>Object</name>
  <id>1</id>
  <valueType>
   <types>DataProcessorObject.SimpleBatchSequence</types>
  </valueType>
  <view>
   <common>true</common>
  </view>
  <edit>
   <common>true</common>
  </edit>
  <main>true</main>
