 <attributes>
  <name>JournalEntryList</name>
  <title>
   <key>tr</key>
   <value>Muhasebe kayıt listesi</value>
  </title>
  <title>
   <key>ru</key>
   <value>Список проводок</value>
  </title>
  <title>
   <key>en</key>
   <value>Journal entry list</value>
  </title>
  <id>5</id>
  <valueType>
   <types>DynamicList</types>
  </valueType>
  <view>
   <common>true</common>
  </view>
  <edit>
   <common>true</common>
  </edit>
  <extInfo xsi:type="form:DynamicListExtInfo">
   <queryText>SELECT
	JournalEntry.Ref,
	JournalEntry.Company,
	JournalEntry.LedgerType,
	JournalEntry.SequentalNumber
FROM
	Document.JournalEntry AS JournalEntry
WHERE
	NOT JournalEntry.DeletionMark
	AND JournalEntry.Company = &amp;Company
	AND JournalEntry.LedgerType = &amp;LedgerType
	AND (JournalEntry.Date BETWEEN BEGINOFPERIOD(&amp;BeginDate, DAY) AND ENDOFPERIOD(&amp;EndDate, DAY)
	OR (JournalEntry.ELedgerRegistry = &amp;ELedgerRegistry AND JournalEntry.ELedgerRegistry &lt;&gt; VALUE(Document.ELedgerRegistry.EmptyRef)))</queryText>
   <autoFillAvailableFields>true</autoFillAvailableFields>
   <customQuery>true</customQuery>
   <autoSaveUserSettings>true</autoSaveUserSettings>
   <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>Ref</dataPath>
    <field>Ref</field>
   </fields>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>Company</dataPath>
    <field>Company</field>
   </fields>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>LedgerType</dataPath>
    <field>LedgerType</field>
   </fields>
   <fields xsi:type="schema:DataCompositionSchemaDataSetField">
    <dataPath>SequentalNumber</dataPath>
    <field>SequentalNumber</field>
   </fields>
   <parameters>
    <name>ELedgerRegistry</name>
    <title>
     <localValue>
      <content>
       <key>tr</key>
       <value>e-Defter kayıt defteri</value>
      </content>
      <content>
       <key>ru</key>
       <value>Реестр E ledger</value>
      </content>
      <content>
       <key>en</key>
       <value>E ledger registry</value>
      </content>
     </localValue>
    </title>
    <valueType>
     <types>DocumentRef.ELedgerRegistry</types>
    </valueType>
    <values xsi:type="core:UndefinedValue"/>
    <useRestriction>true</useRestriction>
   </parameters>
   <parameters>
    <name>BeginDate</name>
    <title>
     <localValue>
      <content>
       <key>tr</key>
       <value>Başlangıç tarihi</value>
      </content>
      <content>
       <key>ru</key>
       <value>Дата начала</value>
      </content>
      <content>
       <key>en</key>
       <value>Begin date</value>
      </content>
     </localValue>
    </title>
    <valueType>
     <types>Date</types>
     <dateQualifiers/>
    </valueType>
    <values xsi:type="core:UndefinedValue"/>
    <useRestriction>true</useRestriction>
   </parameters>
   <parameters>
    <name>EndDate</name>
    <title>
     <localValue>
      <content>
       <key>tr</key>
       <value>Bitiş tarihi</value>
      </content>
      <content>
       <key>ru</key>
       <value>Дата окончания больничного</value>
      </content>
      <content>
       <key>en</key>
       <value>End date</value>
      </content>
     </localValue>
    </title>
    <valueType>
     <types>Date</types>
     <dateQualifiers/>
    </valueType>
    <values xsi:type="core:UndefinedValue"/>
    <useRestriction>true</useRestriction>
   </parameters>
   <parameters>
    <name>Company</name>
    <title>
     <localValue>
      <content>
       <key>tr</key>
       <value>Şirket</value>
      </content>
      <content>
       <key>ru</key>
       <value>Организация</value>
      </content>
      <content>
       <key>en</key>
       <value>Company</value>
      </content>
     </localValue>
    </title>
    <valueType>
     <types>CatalogRef.Companies</types>
    </valueType>
    <values xsi:type="core:UndefinedValue"/>
    <useRestriction>true</useRestriction>
   </parameters>
   <parameters>
    <name>LedgerType</name>
    <title>
     <localValue>
      <content>
       <key>tr</key>
       <value>Defter tipi</value>
      </content>
      <content>
       <key>ru</key>
       <value>Тип учета</value>
      </content>
      <content>
       <key>en</key>
       <value>Ledger type</value>
      </content>
     </localValue>
    </title>
    <valueType>
     <types>CatalogRef.LedgerTypes</types>
    </valueType>
    <values xsi:type="core:UndefinedValue"/>
    <useRestriction>true</useRestriction>
   </parameters>
  </extInfo>
 </attributes>
