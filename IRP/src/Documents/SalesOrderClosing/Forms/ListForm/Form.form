  <extInfo xsi:type="form:DynamicListExtInfo">
   <queryText>SELECT
	SalesOrderClosing.Ref,
	SalesOrderClosing.DeletionMark,
	SalesOrderClosing.Number,
	SalesOrderClosing.Date,
	SalesOrderClosing.Posted,
	SalesOrderClosing.Agreement,
	SalesOrderClosing.Company,
	SalesOrderClosing.TransactionType,
	SalesOrderClosing.LegalName,
	SalesOrderClosing.Partner,
	SalesOrderClosing.SalesOrder,
	SalesOrderClosing.Author,
	SalesOrderClosing.Branch,
	SalesOrderClosing.Comment,
	SalesOrderClosing.DocumentAmount
FROM
	Document.SalesOrderClosing AS SalesOrderClosing</queryText>
   <mainTable>Document.SalesOrderClosing</mainTable>
   <dynamicDataRead>true</dynamicDataRead>
   <autoFillAvailableFields>true</autoFillAvailableFields>
   <customQuery>true</customQuery>
   <autoSaveUserSettings>true</autoSaveUserSettings>
   <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
