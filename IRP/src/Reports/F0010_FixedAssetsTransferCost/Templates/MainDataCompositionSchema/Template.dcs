	<calculatedField>
		<dataPath>ClosingCost</dataPath>
		<expression>(CommisioningCost + OpeningCost +ModernizationCost - DecomissioningCost - TransferCost)
-
((CommisioningCost + OpeningCost +ModernizationCost - DecomissioningCost - TransferCost) * DepreciationRate)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
