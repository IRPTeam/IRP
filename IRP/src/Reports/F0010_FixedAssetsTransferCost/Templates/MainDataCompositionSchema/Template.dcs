		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ISNULL(T8510S_FixedAssetsInfo.FixedAsset, T8515S_FixedAssetsLocation.FixedAsset) AS FixedAsset,
	ISNULL(T8510S_FixedAssetsInfo.Document, T8515S_FixedAssetsLocation.Recorder) AS Document,
	ISNULL(T8510S_FixedAssetsInfo.Company, T8515S_FixedAssetsLocation.Company) AS Company,
	ISNULL(T8510S_FixedAssetsInfo.Branch, T8515S_FixedAssetsLocation.Branch) AS Branch,
	ISNULL(T8510S_FixedAssetsInfo.ProfitLossCenter, T8515S_FixedAssetsLocation.ProfitLossCenter) AS ProfitLossCenter,
	ISNULL(T8510S_FixedAssetsInfo.Amount, 0) AS CommissioningAmount
INTO FA
FROM
	InformationRegister.T8510S_FixedAssetsInfo AS T8510S_FixedAssetsInfo
		FULL JOIN InformationRegister.T8515S_FixedAssetsLocation AS T8515S_FixedAssetsLocation
		ON T8510S_FixedAssetsInfo.Document = T8515S_FixedAssetsLocation.Recorder
		AND T8510S_FixedAssetsInfo.FixedAsset = T8515S_FixedAssetsLocation.FixedAsset
WHERE
	ISNULL(T8510S_FixedAssetsInfo.Company, T8515S_FixedAssetsLocation.Company) = &amp;Company
	AND ISNULL(T8510S_FixedAssetsInfo.Period, T8515S_FixedAssetsLocation.Period) BETWEEN BEGINOFPERIOD(&amp;StartDate,
		DAY) AND ENDOFPERIOD(&amp;EndDate, DAY)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	R8510B_BookValueOfFixedAssetTurnovers.Company AS Company,
	R8510B_BookValueOfFixedAssetTurnovers.Branch AS Branch,
	R8510B_BookValueOfFixedAssetTurnovers.ProfitLossCenter AS ProfitLossCenter,
	R8510B_BookValueOfFixedAssetTurnovers.FixedAsset AS FixedAsset,
	ISNULL(R8510B_BookValueOfFixedAssetBalance.AmountBalance, 0) AS OpeningCost,
	R8510B_BookValueOfFixedAssetTurnovers.Recorder AS Recorder,
	CASE
		WHEN VALUETYPE(R8510B_BookValueOfFixedAssetTurnovers.Recorder) = TYPE(Document.CommissioningOfFixedAsset)
			THEN FA.CommissioningAmount
		ELSE 0
	END AS CommisioningCost,
	CASE
		WHEN VALUETYPE(R8510B_BookValueOfFixedAssetTurnovers.Recorder) = TYPE(Document.ModernizationOfFixedAsset)
			THEN R8510B_BookValueOfFixedAssetTurnovers.AmountTurnover
		ELSE 0
	END AS ModernizationCost,
	CASE
		WHEN VALUETYPE(R8510B_BookValueOfFixedAssetTurnovers.Recorder) = TYPE(Document.FixedAssetTransfer)
			THEN R8510B_BookValueOfFixedAssetTurnovers.AmountTurnover
		ELSE 0
	END AS TransferCost,
	CASE
		WHEN VALUETYPE(R8510B_BookValueOfFixedAssetTurnovers.Recorder) = TYPE(Document.DecommissioningOfFixedAsset)
			THEN R8510B_BookValueOfFixedAssetTurnovers.AmountTurnover
		ELSE 0
	END AS DecomissioningCost,
	ISNULL(R8510B_BookValueOfFixedAssetTurnovers.FixedAsset.Parent.DepreciationRate, 0) AS DepreciationRate
FROM
	FA AS FA
		LEFT JOIN AccumulationRegister.R8510B_BookValueOfFixedAsset.Turnovers({BEGINOFPERIOD(&amp;StartDate, DAY)},
			{ENDOFPERIOD(&amp;EndDate, DAY)}, Record,) AS R8510B_BookValueOfFixedAssetTurnovers
		ON FA.FixedAsset = R8510B_BookValueOfFixedAssetTurnovers.FixedAsset
		AND FA.Document = R8510B_BookValueOfFixedAssetTurnovers.Recorder
		AND
			R8510B_BookValueOfFixedAssetTurnovers.CurrencyMovementType = VALUE(ChartOfCharacteristicTypes.CurrencyMovementType.SettlementCurrency)
		AND FA.Company = R8510B_BookValueOfFixedAssetTurnovers.Company
		AND FA.Branch = R8510B_BookValueOfFixedAssetTurnovers.Branch
		AND FA.ProfitLossCenter = R8510B_BookValueOfFixedAssetTurnovers.ProfitLossCenter,
	AccumulationRegister.R8510B_BookValueOfFixedAsset.Balance({BEGINOFPERIOD(&amp;StartDate, DAY)}, (FixedAsset, Company,
		Branch, ProfitLossCenter, CurrencyMovementType) IN
		(SELECT
			FA.FixedAsset AS FixedAsset,
			FA.Company AS Company,
			FA.Branch AS Branch,
			FA.ProfitLossCenter AS ProfitLossCenter,
			VALUE(ChartOfCharacteristicTypes.CurrencyMovementType.SettlementCurrency)
		FROM
			FA AS FA)) AS R8510B_BookValueOfFixedAssetBalance</query>
	</dataSet>
	<calculatedField>
		<dataPath>BeforeAdjustmentCost</dataPath>
		<expression>CommisioningCost + OpeningCost +ModernizationCost - DecomissioningCost - TransferCost</expression>
		<title xsi:type="v8:LocalStringType">
