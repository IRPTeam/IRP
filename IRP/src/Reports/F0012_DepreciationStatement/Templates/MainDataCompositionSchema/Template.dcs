		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CurrencyMovementType</dataPath>
			<field>CurrencyMovementType</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>TransactionCurrency</dataPath>
			<field>TransactionCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	T8515S_FixedAssetsLocationSliceLast.Company AS Company,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset AS FixedAsset,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset.InventoryNumber AS InventoryNumber,
	T8510S_FixedAssetsInfo.Document AS Document,
	T8515S_FixedAssetsLocationSliceLast.Branch AS Branch,
	T8515S_FixedAssetsLocationSliceLast.ResponsiblePerson AS ResponsiblePerson,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset.Parent.DepreciationRate AS DepreciationRate,
	ISNULL(T8510S_FixedAssetsInfo.Amount, 0) AS InitialCost,
	T8510S_FixedAssetsInfo.Document.Date AS DocumentDate,
	T8510S_FixedAssetsInfo.Document.Number AS DocumentNumber,
	T8510S_FixedAssetsInfo.Period AS CommissioningDate,
	T8510S_FixedAssetsInfo.LedgerType AS LedgerType,
	T8510S_FixedAssetsInfo.Schedule AS Schedule,
	SUM(R8510B_BookValueOfFixedAssetTurnovers.AmountExpense) AS DepreciationAmount
FROM
	InformationRegister.T8515S_FixedAssetsLocation.SliceLast({ENDOFPERIOD(&amp;EndDate, DAY)}, Company = &amp;Company) AS
		T8515S_FixedAssetsLocationSliceLast
		LEFT JOIN InformationRegister.T8510S_FixedAssetsInfo AS T8510S_FixedAssetsInfo
		ON T8515S_FixedAssetsLocationSliceLast.FixedAsset = T8510S_FixedAssetsInfo.FixedAsset
		AND (T8510S_FixedAssetsInfo.Document REFS Document.CommissioningOfFixedAsset
		OR T8510S_FixedAssetsInfo.Document REFS Document.OpeningEntry)
		LEFT JOIN AccumulationRegister.R8510B_BookValueOfFixedAsset.Turnovers({BEGINOFPERIOD(&amp;StartDate, DAY)},
			{ENDOFPERIOD(&amp;EndDate, DAY)}, Record, Company = &amp;Company
		AND CurrencyMovementType = VALUE(ChartOfCharacteristicTypes.CurrencyMovementType.SettlementCurrency)) AS
			R8510B_BookValueOfFixedAssetTurnovers
		ON R8510B_BookValueOfFixedAssetTurnovers.Company = T8510S_FixedAssetsInfo.Company
		AND R8510B_BookValueOfFixedAssetTurnovers.LedgerType = T8510S_FixedAssetsInfo.LedgerType
		AND R8510B_BookValueOfFixedAssetTurnovers.Schedule = T8510S_FixedAssetsInfo.Schedule
		AND R8510B_BookValueOfFixedAssetTurnovers.FixedAsset = T8510S_FixedAssetsInfo.FixedAsset
WHERE
	T8515S_FixedAssetsLocationSliceLast.IsActive
GROUP BY
	T8515S_FixedAssetsLocationSliceLast.Company,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset.InventoryNumber,
	T8510S_FixedAssetsInfo.Document,
	T8515S_FixedAssetsLocationSliceLast.Branch,
	T8515S_FixedAssetsLocationSliceLast.ResponsiblePerson,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset.Parent.DepreciationRate,
	ISNULL(T8510S_FixedAssetsInfo.Amount, 0),
	T8510S_FixedAssetsInfo.Document.Date,
	T8510S_FixedAssetsInfo.Document.Number,
	T8510S_FixedAssetsInfo.Period,
	T8510S_FixedAssetsInfo.LedgerType,
	T8510S_FixedAssetsInfo.Schedule</query>
	</dataSet>
	<calculatedField>
		<dataPath>BalanceAmount</dataPath>
		<expression>InitialCost - DepreciationAmount</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Balance amount</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">15</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
		<dataPath>InitialCost</dataPath>
		<expression>Sum(InitialCost)</expression>
	</totalField>
	<totalField>
		<dataPath>DepreciationAmount</dataPath>
		<expression>Sum(DepreciationAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>BalanceAmount</dataPath>
		<expression>Sum(BalanceAmount)</expression>
	</totalField>
	<parameter>
