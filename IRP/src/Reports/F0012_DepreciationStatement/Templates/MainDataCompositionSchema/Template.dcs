		<dataSource>DataSource1</dataSource>
		<query>SELECT
	T8515S_FixedAssetsLocationSliceLast.FixedAsset AS FixedAsset,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset.InventoryNumber AS InventoryNumber,
	T8515S_FixedAssetsLocationSliceLast.Branch AS Branch,
	T8515S_FixedAssetsLocationSliceLast.ResponsiblePerson AS ResponsiblePerson,
	T8515S_FixedAssetsLocationSliceLast.FixedAsset.Parent.DepreciationRate AS DepreciationRate,
	ISNULL(T8510S_FixedAssetsInfo.Amount, 0) AS InitialCost,
	T8510S_FixedAssetsInfo.Document.Date AS DocumentDate,
	T8510S_FixedAssetsInfo.Document.Number AS DocumentNumber,
	T8510S_FixedAssetsInfo.Period AS CommissioningDate,
	T8510S_FixedAssetsInfo.LedgerType AS LedgerType,
	T8510S_FixedAssetsInfo.Schedule AS Schedule,
	R8510B_BookValueOfFixedAssetTurnovers.AmountOpeningBalance AS OpeningBalance,
	R8510B_BookValueOfFixedAssetTurnovers.AmountExpense AS DepreciationAmount,
	R8510B_BookValueOfFixedAssetTurnovers.AmountClosingBalance AS ClosingBalance
FROM
	InformationRegister.T8515S_FixedAssetsLocation.SliceLast({ENDOFPERIOD(&amp;EndDate, DAY)}, Company = &amp;Company) AS
		T8515S_FixedAssetsLocationSliceLast
		LEFT JOIN InformationRegister.T8510S_FixedAssetsInfo AS T8510S_FixedAssetsInfo
		ON T8515S_FixedAssetsLocationSliceLast.FixedAsset = T8510S_FixedAssetsInfo.FixedAsset
		AND (T8510S_FixedAssetsInfo.Document REFS Document.CommissioningOfFixedAsset
		OR T8510S_FixedAssetsInfo.Document REFS Document.OpeningEntry)
		LEFT JOIN AccumulationRegister.R8510B_BookValueOfFixedAsset.BalanceAndTurnovers({BEGINOFPERIOD(&amp;StartDate, DAY)},
			{ENDOFPERIOD(&amp;EndDate, DAY)},,, Company = &amp;Company
		AND CurrencyMovementType = VALUE(ChartOfCharacteristicTypes.CurrencyMovementType.SettlementCurrency)) AS
			R8510B_BookValueOfFixedAssetTurnovers
		ON R8510B_BookValueOfFixedAssetTurnovers.Company = T8510S_FixedAssetsInfo.Company
		AND R8510B_BookValueOfFixedAssetTurnovers.LedgerType = T8510S_FixedAssetsInfo.LedgerType
		AND R8510B_BookValueOfFixedAssetTurnovers.Schedule = T8510S_FixedAssetsInfo.Schedule
		AND R8510B_BookValueOfFixedAssetTurnovers.FixedAsset = T8510S_FixedAssetsInfo.FixedAsset
WHERE
	T8515S_FixedAssetsLocationSliceLast.IsActive</query>
	</dataSet>
	<totalField>
		<dataPath>InitialCost</dataPath>
		<expression>Sum(InitialCost)</expression>
	</totalField>
	<totalField>
		<dataPath>DepreciationAmount</dataPath>
		<expression>Sum(DepreciationAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>OpeningBalance</dataPath>
		<expression>Count(OpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalance</dataPath>
		<expression>Count(ClosingBalance)</expression>
	</totalField>
