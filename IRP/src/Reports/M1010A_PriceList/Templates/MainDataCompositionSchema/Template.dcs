		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	PricesByItemKeysSliceLast.PriceType AS PriceType,
	PricesByItemKeysSliceLast.ItemKey.Item.ItemType AS ItemType,
	PricesByItemKeysSliceLast.ItemKey AS ItemKey,
	PricesByItemKeysSliceLast.ItemKey.Item AS Item,
	PricesByItemKeysSliceLast.Price AS Price,
	PricesByItemKeysSliceLast.ItemKey.Presentation AS ItemKeyPresentation,
	PricesByItemKeysSliceLast.ItemKey.ItemKeyID AS SKU,
	PricesByItemKeysSliceLast.ItemKey.Item.ItemID AS ModelCode,
	PricesByItemKeysSliceLast.Recorder AS Recorder
INTO Tablo
FROM
	InformationRegister.PricesByItemKeys.SliceLast AS PricesByItemKeysSliceLast
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Tablo.PriceType AS PriceType,
	Tablo.ItemType AS ItemType,
	Tablo.ItemKey AS ItemKey,
	Tablo.Item AS Item,
	Tablo.Price AS Price,
	Tablo.ItemKeyPresentation AS ItemKeyPresentation,
	Tablo.SKU AS SKU,
	Tablo.ModelCode AS ModelCode,
	Tablo.Recorder AS Recorder
FROM
	Tablo AS Tablo</query>
	</dataSet>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Max(Price)</expression>
		<group>ItemKey</group>
		<group>ItemKeyPresentation</group>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
