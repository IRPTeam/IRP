	</totalField>
	<totalField>
		<dataPath>OffersAmount</dataPath>
		<expression>Sum(OffersAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity</dataPath>
		<expression>Sum(Quantity)</expression>
	</totalField>
