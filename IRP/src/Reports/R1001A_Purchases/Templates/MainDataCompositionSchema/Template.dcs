		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R1001T_PurchasesTurnovers.Company AS Company,
	R1001T_PurchasesTurnovers.Branch AS Branch,
	R1001T_PurchasesTurnovers.CurrencyMovementType AS CurrencyMovementType,
	R1001T_PurchasesTurnovers.Currency AS Currency,
	R1001T_PurchasesTurnovers.Invoice AS Invoice,
	Items.Ref AS Item,
	R1001T_PurchasesTurnovers.ItemKey AS ItemKey,
	R1001T_PurchasesTurnovers.QuantityTurnover AS Quantity,
	R1001T_PurchasesTurnovers.AmountTurnover AS Amount,
	R1001T_PurchasesTurnovers.NetAmountTurnover AS NetAmount,
	R1001T_PurchasesTurnovers.OffersAmountTurnover AS OffersAmount,
	R1001T_PurchasesTurnovers.Invoice.Partner AS Partner,
	R1001T_PurchasesTurnovers.Invoice.LegalName AS LegalName,
	R1001T_PurchasesTurnovers.Invoice.Agreement AS PartnerTerms,
	R1001T_PurchasesTurnovers.Recorder AS RecordDocument,
	R1001T_PurchasesTurnovers.SecondPeriod AS SecondPeriod,
	R1001T_PurchasesTurnovers.CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef) AS isTransacitonCurrency
FROM
	AccumulationRegister.R1001T_Purchases.Turnovers(, , Auto, NOT CurrencyMovementType.Type = VALUE(Enum.CurrencyType.Agreement)) AS R1001T_PurchasesTurnovers
		LEFT JOIN Catalog.Items AS Items
		ON R1001T_PurchasesTurnovers.ItemKey.Item = Items.Ref</query>
	</dataSet>
	<totalField>
		<dataPath>Amount</dataPath>
		<expression>Sum(Amount)</expression>
	</totalField>
	<totalField>
