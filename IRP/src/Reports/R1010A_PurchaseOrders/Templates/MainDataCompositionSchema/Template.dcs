		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R1010T_PurchaseOrdersTurnovers.Currency AS Currency,
	R1010T_PurchaseOrdersTurnovers.Company AS Company,
	R1010T_PurchaseOrdersTurnovers.Order AS Order,
	R1010T_PurchaseOrdersTurnovers.ItemKey AS ItemKey,
	R1010T_PurchaseOrdersTurnovers.ItemKey.Item AS Item,
	R1010T_PurchaseOrdersTurnovers.QuantityTurnover AS Quantity,
	R1010T_PurchaseOrdersTurnovers.AmountTurnover AS Amount,
	R1010T_PurchaseOrdersTurnovers.NetAmountTurnover AS NetAmount,
	R1010T_PurchaseOrdersTurnovers.Order.Partner AS Partner,
	CAST(R1010T_PurchaseOrdersTurnovers.Order.LegalName AS Catalog.Companies) AS LegalName,
	R1010T_PurchaseOrdersTurnovers.Recorder AS Recorder,
	R1010T_PurchaseOrdersTurnovers.SecondPeriod AS SecondPeriod
FROM
	AccumulationRegister.R1010T_PurchaseOrders.Turnovers(,, Auto,
		CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef)) AS R1010T_PurchaseOrdersTurnovers</query>
	</dataSet>
