		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Order AS Order,
	NOT PurchaseOrderClosing.Ref IS NULL AS Closed
INTO ClosedPurchaseOrders
FROM
	AccumulationRegister.R1011B_PurchaseOrdersReceipt.BalanceAndTurnovers(, , Auto, , ) AS R1011B_PurchaseOrdersReceiptBalanceAndTurnovers
		LEFT JOIN Document.PurchaseOrderClosing AS PurchaseOrderClosing
		ON R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Order = PurchaseOrderClosing.PurchaseOrder
			AND (PurchaseOrderClosing.Posted)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Company AS Company,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Order AS Order,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.ItemKey.Item AS Item,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.ItemKey AS ItemKey,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Recorder AS Recorder,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Order.LegalName AS OrderLegalName,
	R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Order.Partner AS OrderPartner,
	ClosedPurchaseOrders.Closed AS Closed
FROM
	AccumulationRegister.R1011B_PurchaseOrdersReceipt.BalanceAndTurnovers(, , Auto, , ) AS R1011B_PurchaseOrdersReceiptBalanceAndTurnovers
		LEFT JOIN ClosedPurchaseOrders AS ClosedPurchaseOrders
		ON R1011B_PurchaseOrdersReceiptBalanceAndTurnovers.Order = ClosedPurchaseOrders.Order</query>
	</dataSet>
	<totalField>
		<dataPath>QuantityClosingBalance</dataPath>
		<expression>Sum(QuantityClosingBalance)</expression>
	</totalField>
