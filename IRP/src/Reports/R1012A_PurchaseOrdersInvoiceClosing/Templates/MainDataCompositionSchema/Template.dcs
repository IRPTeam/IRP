		<field xsi:type="DataSetFieldFolder">
			<dataPath>Amount</dataPath>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Tutar</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Amount</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.Company AS Company,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.Order AS Order,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.Currency AS Currency,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.ItemKey.Item AS Item,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.ItemKey AS ItemKey,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountExpense AS AmountExpense,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.NetAmountOpeningBalance AS NetAmountOpeningBalance,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.NetAmountReceipt AS NetAmountReceipt,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.NetAmountExpense AS NetAmountExpense,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.NetAmountClosingBalance AS NetAmountClosingBalance,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.Recorder AS Recorder,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.Order.LegalName AS LegalName,
	R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.Order.Partner AS Partner,
	CASE
		WHEN R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityReceipt = 0
			THEN 0
		ELSE R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountReceipt / R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityReceipt
	END AS ReceiptAVGPrice,
	CASE
		WHEN R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityExpense = 0
			THEN 0
		ELSE R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountExpense / R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityExpense
	END AS ExpenseAVGPrice,
	CASE
		WHEN R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityExpense = 0 OR R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityReceipt = 0
			THEN 0
		ELSE R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountReceipt / R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityReceipt - R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.AmountExpense / R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers.QuantityExpense
	END AS PriceDifference
FROM
	AccumulationRegister.R1012B_PurchaseOrdersInvoiceClosing.BalanceAndTurnovers(, , Auto, , ) AS R1012B_PurchaseOrdersInvoiceClosingBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>ReceiptAVGPrice</dataPath>
		<expression>Avg(ReceiptAVGPrice)</expression>
		<group>Item</group>
		<group>ItemKey</group>
	</totalField>
	<totalField>
		<dataPath>ExpenseAVGPrice</dataPath>
		<expression>Avg(ExpenseAVGPrice)</expression>
		<group>Item</group>
		<group>ItemKey</group>
	</totalField>
	<totalField>
		<dataPath>PriceDifference</dataPath>
		<expression>Avg(PriceDifference)</expression>
		<group>Item</group>
		<group>ItemKey</group>
	</totalField>
	<totalField>
		<dataPath>Amount.AmountOpeningBalance</dataPath>
		<expression>Sum(Amount.AmountOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.AmountReceipt</dataPath>
		<expression>Sum(Amount.AmountReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.AmountExpense</dataPath>
		<expression>Sum(Amount.AmountExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.AmountClosingBalance</dataPath>
		<expression>Sum(Amount.AmountClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>NetAmount.NetAmountOpeningBalance</dataPath>
		<expression>Sum(NetAmount.NetAmountOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>NetAmount.NetAmountReceipt</dataPath>
		<expression>Sum(NetAmount.NetAmountReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>NetAmount.NetAmountExpense</dataPath>
		<expression>Sum(NetAmount.NetAmountExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>NetAmount.NetAmountClosingBalance</dataPath>
		<expression>Sum(NetAmount.NetAmountClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.QuantityOpeningBalance</dataPath>
		<expression>Sum(Quantity.QuantityOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.QuantityReceipt</dataPath>
		<expression>Sum(Quantity.QuantityReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.QuantityExpense</dataPath>
		<expression>Sum(Quantity.QuantityExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.QuantityClosingBalance</dataPath>
		<expression>Sum(Quantity.QuantityClosingBalance)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Begin of period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
