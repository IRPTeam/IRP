		<group>ItemKey</group>
	</totalField>
	<totalField>
		<dataPath>ExpenseAVGPrice</dataPath>
		<expression>Avg(ExpenseAVGPrice)</expression>
		<group>Item</group>
		<group>ItemKey</group>
	</totalField>
	<totalField>
