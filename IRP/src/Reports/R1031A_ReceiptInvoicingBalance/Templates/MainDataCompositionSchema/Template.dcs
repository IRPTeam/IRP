		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R1031B_ReceiptInvoicingBalance.Company AS Company,
	R1031B_ReceiptInvoicingBalance.Basis AS Basis,
	R1031B_ReceiptInvoicingBalance.ItemKey.Item AS Item,
	R1031B_ReceiptInvoicingBalance.ItemKey AS ItemKey,
	R1031B_ReceiptInvoicingBalance.QuantityBalance AS Quantity
FROM
	AccumulationRegister.R1031B_ReceiptInvoicing.Balance AS R1031B_ReceiptInvoicingBalance</query>
	</dataSet>
	<totalField>
		<dataPath>Quantity</dataPath>
		<expression>Sum(Quantity)</expression>
