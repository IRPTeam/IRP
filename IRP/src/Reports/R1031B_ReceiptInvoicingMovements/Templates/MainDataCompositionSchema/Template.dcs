		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R1031B_ReceiptInvoicingBalanceAndTurnovers.Company AS Company,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.Basis AS Basis,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.ItemKey.Item AS Item,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.ItemKey AS ItemKey,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R1031B_ReceiptInvoicingBalanceAndTurnovers.Recorder AS Recorder
FROM
	AccumulationRegister.R1031B_ReceiptInvoicing.BalanceAndTurnovers(, , Auto, , ) AS R1031B_ReceiptInvoicingBalanceAndTurnovers</query>
	</dataSet>
