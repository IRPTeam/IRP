		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SalesOrderTurnovers.Company AS Company,
	SalesOrderTurnovers.Branch AS Branch,
	SalesOrderTurnovers.Order AS SalesOrder,
	SalesOrderTurnovers.ItemKey AS ItemKey,
	SUM(SalesOrderTurnovers.QuantityTurnover) AS OrderQuantity,
	SUM(SalesOrderTurnovers.AmountTurnover) AS OrderAmount
INTO tempSalesOrders
FROM
	AccumulationRegister.R2010T_SalesOrders.Turnovers(, , Recorder, CurrencyMovementType = VALUE(ChartOfCharacteristicTypes.CurrencyMovementType.SettlementCurrency)) AS SalesOrderTurnovers
WHERE
	SalesOrderTurnovers.Recorder REFS Document.SalesOrder

GROUP BY
	SalesOrderTurnovers.Order,
	SalesOrderTurnovers.ItemKey,
	SalesOrderTurnovers.Company,
	SalesOrderTurnovers.Branch
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CanceledSalesOrders.Order AS Order,
	CanceledSalesOrders.ItemKey AS ItemKey,
	SUM(CanceledSalesOrders.QuantityTurnover) AS CanceledQuantity,
	SUM(CanceledSalesOrders.AmountTurnover) AS CanceledAmount
INTO tempCanceled
FROM
	AccumulationRegister.R2014T_CanceledSalesOrders.Turnovers(, , , CurrencyMovementType = VALUE(ChartOfCharacteristicTypes.CurrencyMovementType.SettlementCurrency)) AS CanceledSalesOrders
		INNER JOIN tempSalesOrders AS tempSalesOrders
		ON CanceledSalesOrders.Order = tempSalesOrders.SalesOrder
			AND CanceledSalesOrders.ItemKey = tempSalesOrders.ItemKey

GROUP BY
	CanceledSalesOrders.Order,
	CanceledSalesOrders.ItemKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	R2011B_SalesOrdersShipmentTurnovers.Order AS Order,
	R2011B_SalesOrdersShipmentTurnovers.ItemKey AS ItemKey,
	SUM(R2011B_SalesOrdersShipmentTurnovers.QuantityExpense) AS ShippedQuantity
INTO tempShipment
FROM
	AccumulationRegister.R2011B_SalesOrdersShipment.Turnovers(, , , ) AS R2011B_SalesOrdersShipmentTurnovers
		INNER JOIN tempSalesOrders AS tempSalesOrders
		ON R2011B_SalesOrdersShipmentTurnovers.Order = tempSalesOrders.SalesOrder
			AND R2011B_SalesOrdersShipmentTurnovers.ItemKey = tempSalesOrders.ItemKey

GROUP BY
	R2011B_SalesOrdersShipmentTurnovers.Order,
	R2011B_SalesOrdersShipmentTurnovers.ItemKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	R2012B_SalesOrdersInvoiceClosingTurnovers.Order AS Order,
	R2012B_SalesOrdersInvoiceClosingTurnovers.ItemKey AS ItemKey,
	SUM(R2012B_SalesOrdersInvoiceClosingTurnovers.QuantityExpense) AS InvoicedQuantity,
	SUM(R2012B_SalesOrdersInvoiceClosingTurnovers.AmountExpense) AS InvoicedAmount
INTO tempInvoiced
FROM
	AccumulationRegister.R2012B_SalesOrdersInvoiceClosing.Turnovers(, , , ) AS R2012B_SalesOrdersInvoiceClosingTurnovers
		INNER JOIN tempSalesOrders AS tempSalesOrders
		ON R2012B_SalesOrdersInvoiceClosingTurnovers.Order = tempSalesOrders.SalesOrder
			AND R2012B_SalesOrdersInvoiceClosingTurnovers.ItemKey = tempSalesOrders.ItemKey

GROUP BY
	R2012B_SalesOrdersInvoiceClosingTurnovers.Order,
	R2012B_SalesOrdersInvoiceClosingTurnovers.ItemKey
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	tempSalesOrders.Company AS Company,
	tempSalesOrders.Branch AS Branch,
	tempSalesOrders.SalesOrder AS Order,
	tempSalesOrders.ItemKey.Item AS Item,
	tempSalesOrders.ItemKey AS ItemKey,
	tempSalesOrders.OrderQuantity AS OrderQuantity,
	tempSalesOrders.OrderAmount AS OrderAmount,
	ISNULL(tempShipment.ShippedQuantity, 0) AS ShippedQuantity,
	ISNULL(tempInvoiced.InvoicedQuantity, 0) AS InvoicedQuantity,
	ISNULL(tempInvoiced.InvoicedAmount, 0) AS InvoicedAmount,
	ISNULL(tempCanceled.CanceledQuantity, 0) AS CanceledQuantity,
	ISNULL(tempCanceled.CanceledAmount, 0) AS CanceledAmount
FROM
	tempSalesOrders AS tempSalesOrders
		LEFT JOIN tempShipment AS tempShipment
		ON tempSalesOrders.SalesOrder = tempShipment.Order
			AND tempSalesOrders.ItemKey = tempShipment.ItemKey
		LEFT JOIN tempCanceled AS tempCanceled
		ON tempSalesOrders.SalesOrder = tempCanceled.Order
			AND tempSalesOrders.ItemKey = tempCanceled.ItemKey
		LEFT JOIN tempInvoiced AS tempInvoiced
		ON tempSalesOrders.SalesOrder = tempInvoiced.Order
			AND tempSalesOrders.ItemKey = tempInvoiced.ItemKey</query>
	</dataSet>
