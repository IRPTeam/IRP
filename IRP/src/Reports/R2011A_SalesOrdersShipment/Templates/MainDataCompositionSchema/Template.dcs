	</totalField>
	<totalField>
		<dataPath>QuantityReceipt</dataPath>
		<expression>Sum(QuantityReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>ToBeReserved</dataPath>
		<expression>Sum(ToBeReserved)</expression>
	</totalField>
