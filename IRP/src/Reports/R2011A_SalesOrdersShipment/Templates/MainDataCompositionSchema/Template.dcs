		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.Order AS Order,
	NOT SalesOrderClosing.Ref IS NULL AS OrderClosed
INTO OrderClosing
FROM
	AccumulationRegister.R2011B_SalesOrdersShipment.BalanceAndTurnovers(, , Auto, , ) AS R2011B_SalesOrdersShipmentBalanceAndTurnovers
		LEFT JOIN Document.SalesOrderClosing AS SalesOrderClosing
		ON R2011B_SalesOrdersShipmentBalanceAndTurnovers.Order = SalesOrderClosing.SalesOrder
			AND (SalesOrderClosing.Posted)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.Company AS Company,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.Order AS Order,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.ItemKey.Item AS Item,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.ItemKey AS ItemKey,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.Recorder AS Recorder,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	OrderClosing.OrderClosed AS OrderClosed,
	ISNULL(R4012B_StockReservationBalance.QuantityBalance, 0) AS InReserve,
	R2011B_SalesOrdersShipmentBalanceAndTurnovers.QuantityReceipt - ISNULL(R4012B_StockReservationBalance.QuantityBalance, 0) AS ToBeReserved
FROM
	AccumulationRegister.R2011B_SalesOrdersShipment.BalanceAndTurnovers(, , Auto, , ) AS R2011B_SalesOrdersShipmentBalanceAndTurnovers
		LEFT JOIN OrderClosing AS OrderClosing
		ON R2011B_SalesOrdersShipmentBalanceAndTurnovers.Order = OrderClosing.Order
		LEFT JOIN AccumulationRegister.R4012B_StockReservation.Balance AS R4012B_StockReservationBalance
		ON R2011B_SalesOrdersShipmentBalanceAndTurnovers.Order = R4012B_StockReservationBalance.Order
			AND R2011B_SalesOrdersShipmentBalanceAndTurnovers.ItemKey = R4012B_StockReservationBalance.ItemKey
</query>
	</dataSet>
