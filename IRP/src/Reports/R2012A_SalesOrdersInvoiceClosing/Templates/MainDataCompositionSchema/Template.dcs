		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.Recorder AS Recorder,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.Company AS Company,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.Currency AS Currency,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.Order AS Order,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.ItemKey.Item AS Item,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.ItemKey AS ItemKey,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.AmountExpense AS AmountExpense,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance
FROM
	AccumulationRegister.R2012B_SalesOrdersInvoiceClosing.BalanceAndTurnovers(,, Auto,,) AS
		R2012B_SalesOrdersInvoiceClosingBalanceAndTurnovers</query>
	</dataSet>
