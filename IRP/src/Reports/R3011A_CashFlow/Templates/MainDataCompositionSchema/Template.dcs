		<field xsi:type="DataSetFieldField">
			<dataPath>CashFlowCenter</dataPath>
			<field>CashFlowCenter</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R3011T_CashFlowTurnovers.Company AS Company,
	R3011T_CashFlowTurnovers.Branch AS Branch,
	R3011T_CashFlowTurnovers.Account AS Account,
	R3011T_CashFlowTurnovers.Direction AS Direction,
	R3011T_CashFlowTurnovers.FinancialMovementType AS FinancialMovementType,
	R3011T_CashFlowTurnovers.PlanningPeriod AS PlanningPeriod,
	R3011T_CashFlowTurnovers.Currency AS Currency,
	CASE
		WHEN R3011T_CashFlowTurnovers.Direction = VALUE(Enum.CashFlowDirections.Outgoing)
			THEN -R3011T_CashFlowTurnovers.AmountTurnover
		ELSE R3011T_CashFlowTurnovers.AmountTurnover
	END AS Amount,
	R3011T_CashFlowTurnovers.Recorder AS Recorder,
	R3011T_CashFlowTurnovers.SecondPeriod AS SecondPeriod,
	R3011T_CashFlowTurnovers.Account.Type AS AccountType,
	R3011T_CashFlowTurnovers.MonthPeriod AS MonthPeriod
FROM
	AccumulationRegister.R3011T_CashFlow.Turnovers(, , Auto, CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef)) AS R3011T_CashFlowTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>Amount</dataPath>
		<expression>Sum(Amount)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Begin of period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.StartDate</expression>
	</parameter>
	<parameter>
