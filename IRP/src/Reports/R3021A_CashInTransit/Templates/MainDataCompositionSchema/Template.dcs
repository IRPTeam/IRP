		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R3021B_CashInTransitIncomingBalanceAndTurnovers.Recorder AS Recorder,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.Company AS Company,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.Branch AS Branch,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.Account AS Account,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.Currency AS Currency,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.Basis AS Basis,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.AmountExpense AS AmountExpense,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance,
	R3021B_CashInTransitIncomingBalanceAndTurnovers.Account.Type AS AccountType
FROM
	AccumulationRegister.R3021B_CashInTransitIncoming.BalanceAndTurnovers(, , Auto, , CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef)) AS R3021B_CashInTransitIncomingBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>Amount.OpeningBalance</dataPath>
		<expression>Sum(Amount.OpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.Receipt</dataPath>
		<expression>Sum(Amount.Receipt)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.Expense</dataPath>
		<expression>Sum(Amount.Expense)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.ClosingBalance</dataPath>
		<expression>Sum(Amount.ClosingBalance)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Begin of period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.StartDate</expression>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>End of period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.EndDate</expression>
	</parameter>
	<parameter>
		<name>ReportPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor dönemi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Default</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Bugün nakit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>За сегодня</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Today cash</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemFolder">
					<dcsset:lwsTitle>
