		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.Company AS Company,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.Branch AS Branch,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.Currency AS Currency,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.Partner AS Partner,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.LegalName AS LegalName,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.Order.Agreement AS PartnerTerms,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.Order AS Order,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.AmountExpense AS AmountExpense,
	R3024B_SalesOrdersToBePaidBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance
FROM
	AccumulationRegister.R3024B_SalesOrdersToBePaid.BalanceAndTurnovers AS R3024B_SalesOrdersToBePaidBalanceAndTurnovers</query>
	</dataSet>
