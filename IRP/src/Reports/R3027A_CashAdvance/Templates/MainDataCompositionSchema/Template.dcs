		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.Company AS Company,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.Branch AS Branch,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.Currency AS Currency,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.Partner AS Partner,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.Agreement AS Agreement,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.AmountTurnover AS AmountTurnover,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.AmountExpense AS AmountExpense,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.Recorder AS Recorder,
	R3027B_EmployeeCashAdvanceBalanceAndTurnovers.SecondPeriod AS SecondPeriod
FROM
	AccumulationRegister.R3027B_EmployeeCashAdvance.BalanceAndTurnovers(,, Auto,,
		CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef)) AS R3027B_EmployeeCashAdvanceBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>Amount.OpeningBalance</dataPath>
		<expression>Sum(Amount.OpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.Receipt</dataPath>
		<expression>Sum(Amount.Receipt)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.Turnover</dataPath>
		<expression>Sum(Amount.Turnover)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.Expense</dataPath>
		<expression>Sum(Amount.Expense)</expression>
	</totalField>
	<totalField>
		<dataPath>Amount.ClosingBalance</dataPath>
		<expression>Sum(Amount.ClosingBalance)</expression>
	</totalField>
