		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	StockBalanceBalanceAndTurnovers.Store AS Store,
	StockBalanceBalanceAndTurnovers.ItemKey.Item AS Item,
	StockBalanceBalanceAndTurnovers.ItemKey AS ItemKey,
	StockBalanceBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	StockBalanceBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	StockBalanceBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	StockBalanceBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	StockBalanceBalanceAndTurnovers.Recorder AS Recorder,
	StockBalanceBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	StockBalanceBalanceAndTurnovers.SerialLotNumber AS SerialLotNumber
FROM
	AccumulationRegister.R4010B_ActualStocks.BalanceAndTurnovers(, , Auto, , ) AS StockBalanceBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>Quantity.OpeningBalance</dataPath>
		<expression>Sum(Quantity.OpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.Receipt</dataPath>
		<expression>Sum(Quantity.Receipt)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.Expense</dataPath>
		<expression>Sum(Quantity.Expense)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.ClosingBalance</dataPath>
		<expression>Sum(Quantity.ClosingBalance)</expression>
	</totalField>
