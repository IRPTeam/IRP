		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R4011B_FreeStocksBalanceAndTurnovers.Store AS Store,
	R4011B_FreeStocksBalanceAndTurnovers.ItemKey.Item AS Item,
	R4011B_FreeStocksBalanceAndTurnovers.ItemKey AS ItemKey,
	R4011B_FreeStocksBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R4011B_FreeStocksBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R4011B_FreeStocksBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R4011B_FreeStocksBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R4011B_FreeStocksBalanceAndTurnovers.Recorder AS Recorder,
	R4011B_FreeStocksBalanceAndTurnovers.SecondPeriod AS SecondPeriod
FROM
	AccumulationRegister.R4011B_FreeStocks.BalanceAndTurnovers(, , Auto, , ) AS R4011B_FreeStocksBalanceAndTurnovers</query>
	</dataSet>
