		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R4012B_StockReservationBalance.Store AS Store,
	R4012B_StockReservationBalance.ItemKey AS ItemKey,
	R4012B_StockReservationBalance.Order AS Order,
	R4012B_StockReservationBalance.QuantityBalance AS Quantity,
	R4012B_StockReservationBalance.ItemKey.Item AS Item
FROM
	AccumulationRegister.R4012B_StockReservation.Balance AS R4012B_StockReservationBalance</query>
	</dataSet>
	<totalField>
		<dataPath>Quantity</dataPath>
		<expression>Sum(Quantity)</expression>
	</totalField>
