		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R4031B_GoodsInTransitIncomingBalance.Store AS Store,
	R4031B_GoodsInTransitIncomingBalance.Basis AS Basis,
	R4031B_GoodsInTransitIncomingBalance.ItemKey AS ItemKey,
	R4031B_GoodsInTransitIncomingBalance.QuantityBalance AS ToReceive,
	0 AS ToSend
INTO ResultTable
FROM
	AccumulationRegister.R4031B_GoodsInTransitIncoming.Balance AS R4031B_GoodsInTransitIncomingBalance

UNION ALL

SELECT
	R4032B_GoodsInTransitOutgoingBalance.Store,
	R4032B_GoodsInTransitOutgoingBalance.Basis,
	R4032B_GoodsInTransitOutgoingBalance.ItemKey,
	0,
	R4032B_GoodsInTransitOutgoingBalance.QuantityBalance
FROM
	AccumulationRegister.R4032B_GoodsInTransitOutgoing.Balance AS R4032B_GoodsInTransitOutgoingBalance
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ResultTable.Store AS Store,
	ResultTable.Basis AS Basis,
	ResultTable.ItemKey.Item AS Item,
	ResultTable.ItemKey AS ItemKey,
	ResultTable.ToReceive AS ToReceive,
	ResultTable.ToSend AS ToSend
FROM
	ResultTable AS ResultTable</query>
	</dataSet>
	<totalField>
		<dataPath>ToReceive</dataPath>
		<expression>Sum(ToReceive)</expression>
	</totalField>
	<totalField>
		<dataPath>ToSend</dataPath>
		<expression>Sum(ToSend)</expression>
	</totalField>
