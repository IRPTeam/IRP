		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R4050B_StockInventoryBalanceAndTurnovers.Company AS Company,
	R4050B_StockInventoryBalanceAndTurnovers.Store AS Store,
	R4050B_StockInventoryBalanceAndTurnovers.ItemKey.Item AS Item,
	R4050B_StockInventoryBalanceAndTurnovers.ItemKey AS ItemKey,
	R4050B_StockInventoryBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R4050B_StockInventoryBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R4050B_StockInventoryBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R4050B_StockInventoryBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R4050B_StockInventoryBalanceAndTurnovers.Recorder AS Recorder,
	R4050B_StockInventoryBalanceAndTurnovers.SecondPeriod AS SecondPeriod
FROM
	AccumulationRegister.R4050B_StockInventory.BalanceAndTurnovers(, , Auto, , ) AS R4050B_StockInventoryBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>Quantity.OpeningBalance</dataPath>
		<expression>Sum(Quantity.OpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.Receipt</dataPath>
		<expression>Sum(Quantity.Receipt)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.Expense</dataPath>
		<expression>Sum(Quantity.Expense)</expression>
	</totalField>
	<totalField>
		<dataPath>Quantity.ClosingBalance</dataPath>
		<expression>Sum(Quantity.ClosingBalance)</expression>
	</totalField>
