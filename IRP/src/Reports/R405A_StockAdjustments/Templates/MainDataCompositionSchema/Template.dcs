		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R4051T_StockAdjustmentAsWriteOffTurnovers.Store AS Store,
	R4051T_StockAdjustmentAsWriteOffTurnovers.Basis AS Basis,
	R4051T_StockAdjustmentAsWriteOffTurnovers.ItemKey.Item AS Item,
	R4051T_StockAdjustmentAsWriteOffTurnovers.ItemKey AS ItemKey,
	R4051T_StockAdjustmentAsWriteOffTurnovers.QuantityTurnover AS QuantityWriteOff,
	0 AS QuantitySurplus,
	-R4051T_StockAdjustmentAsWriteOffTurnovers.QuantityTurnover AS QuantityTotal,
	R4051T_StockAdjustmentAsWriteOffTurnovers.Recorder AS Recorder,
	R4051T_StockAdjustmentAsWriteOffTurnovers.SecondPeriod AS SecondPeriod,
	R4051T_StockAdjustmentAsWriteOffTurnovers.MonthPeriod AS MonthPeriod
FROM
	AccumulationRegister.R4051T_StockAdjustmentAsWriteOff.Turnovers(, , Auto, ) AS R4051T_StockAdjustmentAsWriteOffTurnovers

UNION ALL

SELECT
	R4052T_StockAdjustmentAsSurplusTurnovers.Store,
	R4052T_StockAdjustmentAsSurplusTurnovers.Basis,
	R4052T_StockAdjustmentAsSurplusTurnovers.ItemKey.Item,
	R4052T_StockAdjustmentAsSurplusTurnovers.ItemKey,
	0,
	R4052T_StockAdjustmentAsSurplusTurnovers.QuantityTurnover,
	R4052T_StockAdjustmentAsSurplusTurnovers.QuantityTurnover,
	R4052T_StockAdjustmentAsSurplusTurnovers.Recorder,
	R4052T_StockAdjustmentAsSurplusTurnovers.SecondPeriod,
	R4052T_StockAdjustmentAsSurplusTurnovers.MonthPeriod
FROM
	AccumulationRegister.R4052T_StockAdjustmentAsSurplus.Turnovers(, , Auto, ) AS R4052T_StockAdjustmentAsSurplusTurnovers</query>
	</dataSet>
