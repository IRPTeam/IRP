		<dataPath>TransactionCurrency.AmountClosingBalance</dataPath>
		<expression>Sum(TransactionCurrency.AmountClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>TransactionCurrency.AmountExpense</dataPath>
		<expression>Sum(TransactionCurrency.AmountExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>TransactionCurrency.AmountOpeningBalance</dataPath>
		<expression>Sum(TransactionCurrency.AmountOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>TransactionCurrency.AmountReceipt</dataPath>
		<expression>Sum(TransactionCurrency.AmountReceipt)</expression>
	</totalField>
