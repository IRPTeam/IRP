		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ReconciliationStatementBalanceAndTurnovers.Recorder AS Recorder,
	ReconciliationStatementBalanceAndTurnovers.Company AS Company,
	ReconciliationStatementBalanceAndTurnovers.LegalName AS LegalName,
	ReconciliationStatementBalanceAndTurnovers.Currency AS Currency,
	ReconciliationStatementBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance,
	ReconciliationStatementBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance,
	ReconciliationStatementBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	ReconciliationStatementBalanceAndTurnovers.AmountExpense AS AmountExpense,
	ReconciliationStatementBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	ReconciliationStatementBalanceAndTurnovers.LegalNameContract AS LegalNameContract
FROM
	AccumulationRegister.R5010B_ReconciliationStatement.BalanceAndTurnovers(, , Auto, , ) AS ReconciliationStatementBalanceAndTurnovers</query>
	</dataSet>
