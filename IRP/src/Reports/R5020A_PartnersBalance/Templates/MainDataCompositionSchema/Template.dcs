		<query>SELECT
	R5020B_PartnersBalanceBalanceAndTurnovers.Company AS Company,
	R5020B_PartnersBalanceBalanceAndTurnovers.Branch AS Branch,
	R5020B_PartnersBalanceBalanceAndTurnovers.CurrencyMovementType AS CurrencyMovementType,
	R5020B_PartnersBalanceBalanceAndTurnovers.Currency AS Currency,
	R5020B_PartnersBalanceBalanceAndTurnovers.TransactionCurrency AS TransactionCurrency,
	R5020B_PartnersBalanceBalanceAndTurnovers.LegalName AS LegalName,
	R5020B_PartnersBalanceBalanceAndTurnovers.Partner AS Partner,
	R5020B_PartnersBalanceBalanceAndTurnovers.Agreement AS PartnerTerms,
	R5020B_PartnersBalanceBalanceAndTurnovers.Document AS Basis,
	R5020B_PartnersBalanceBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R5020B_PartnersBalanceBalanceAndTurnovers.DayPeriod AS DayPeriod,
	R5020B_PartnersBalanceBalanceAndTurnovers.WeekPeriod AS WeekPeriod,
	R5020B_PartnersBalanceBalanceAndTurnovers.TenDaysPeriod AS TenDaysPeriod,
	R5020B_PartnersBalanceBalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	R5020B_PartnersBalanceBalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	R5020B_PartnersBalanceBalanceAndTurnovers.YearPeriod AS YearPeriod,
	CASE
		WHEN R5020B_PartnersBalanceBalanceAndTurnovers.Recorder = UNDEFINED
			THEN NULL
		ELSE R5020B_PartnersBalanceBalanceAndTurnovers.Recorder
	END AS Document,
	R5020B_PartnersBalanceBalanceAndTurnovers.CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef) AS isTransacitonCurrency,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionOpeningBalance + R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceOpeningBalance + R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionOpeningBalance + R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceOpeningBalance + R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionOpeningBalance AS TT_Opening,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionReceipt + R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceReceipt + R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionReceipt + R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceReceipt + R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionReceipt AS TT_Receipt,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionExpense + R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceExpense + R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionExpense + R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceExpense + R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionExpense AS TT_Expense,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionClosingBalance + R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceClosingBalance + R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionClosingBalance + R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceClosingBalance + R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionClosingBalance AS TT_Balance,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionOpeningBalance AS CT_Opening,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionReceipt AS CT_Receipt,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionExpense AS CT_Expense,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerTransactionClosingBalance AS CT_Balance,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceOpeningBalance AS CA_Opening,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceReceipt AS CA_Receipt,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceExpense AS CA_Expense,
	R5020B_PartnersBalanceBalanceAndTurnovers.CustomerAdvanceClosingBalance AS CA_Balance,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionOpeningBalance AS VT_Opening,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionReceipt AS VT_Receipt,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionExpense AS VT_Expense,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorTransactionClosingBalance AS VT_Balance,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceOpeningBalance AS VA_Opening,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceReceipt AS VA_Receipt,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceExpense AS VA_Expense,
	R5020B_PartnersBalanceBalanceAndTurnovers.VendorAdvanceClosingBalance AS VA_Balance,
	R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionOpeningBalance AS OT_Opening,
	R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionReceipt AS OT_Receipt,
	R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionExpense AS OT_Expense,
	R5020B_PartnersBalanceBalanceAndTurnovers.OtherTransactionClosingBalance AS OT_Closing
FROM
	AccumulationRegister.R5020B_PartnersBalance.BalanceAndTurnovers(, , Auto, , NOT CurrencyMovementType.Type = VALUE(Enum.CurrencyType.Agreement)) AS R5020B_PartnersBalanceBalanceAndTurnovers</query>
	</dataSet>
