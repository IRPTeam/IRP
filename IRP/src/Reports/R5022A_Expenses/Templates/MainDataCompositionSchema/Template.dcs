		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ExpensesTurnoversTurnovers.Company AS Company,
	ExpensesTurnoversTurnovers.Branch AS BusinessUnit,
	ExpensesTurnoversTurnovers.ExpenseType AS ExpenseType,
	ExpensesTurnoversTurnovers.AmountTurnover AS AmountTurnover,
	ExpensesTurnoversTurnovers.Recorder AS Recorder,
	ExpensesTurnoversTurnovers.SecondPeriod AS SecondPeriod,
	ExpensesTurnoversTurnovers.MonthPeriod AS MonthPeriod,
	ExpensesTurnoversTurnovers.Currency AS Currency,
	ExpensesTurnoversTurnovers.AmountWithTaxesTurnover AS AmountWithTaxes,
	ExpensesTurnoversTurnovers.ProfitLossCenter AS ProfitLossCenter,
	ExpensesTurnoversTurnovers.AdditionalAnalytic AS AdditionalAnalytic
INTO TransactionCurrency
FROM
	AccumulationRegister.R5022T_Expenses.Turnovers(, , Auto, CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef)) AS ExpensesTurnoversTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ExpensesTurnoversTurnovers.Company AS Company,
	ExpensesTurnoversTurnovers.Branch AS BusinessUnit,
	ExpensesTurnoversTurnovers.ExpenseType AS ExpenseType,
	ExpensesTurnoversTurnovers.AmountTurnover AS AmountTurnover,
	ExpensesTurnoversTurnovers.Recorder AS Recorder,
	ExpensesTurnoversTurnovers.SecondPeriod AS SecondPeriod,
	ExpensesTurnoversTurnovers.MonthPeriod AS MonthPeriod,
	ExpensesTurnoversTurnovers.AmountWithTaxesTurnover AS AmountWithTaxes,
	ExpensesTurnoversTurnovers.ProfitLossCenter AS ProfitLossCenter,
	ExpensesTurnoversTurnovers.AdditionalAnalytic AS AdditionalAnalytic
INTO LocalCurrency
FROM
	AccumulationRegister.R5022T_Expenses.Turnovers(, , Auto, CurrencyMovementType.Type = VALUE(Enum.CurrencyType.Legal)) AS ExpensesTurnoversTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TransactionCurrency.Company AS Company,
	TransactionCurrency.BusinessUnit AS BusinessUnit,
	TransactionCurrency.ExpenseType AS ExpenseType,
	TransactionCurrency.AmountTurnover AS AmountTurnover,
	TransactionCurrency.Recorder AS Recorder,
	TransactionCurrency.SecondPeriod AS SecondPeriod,
	TransactionCurrency.MonthPeriod AS MonthPeriod,
	TransactionCurrency.Currency AS Currency,
	LocalCurrency.AmountTurnover AS AmountLocal,
	TransactionCurrency.AmountWithTaxes AS AmountWithTaxes,
	LocalCurrency.AmountWithTaxes AS AmountWithTaxesLocal,
	TransactionCurrency.ProfitLossCenter AS ProfitLossCenter,
	TransactionCurrency.AdditionalAnalytic AS AdditionalAnalytic
FROM
	TransactionCurrency AS TransactionCurrency
		LEFT JOIN LocalCurrency AS LocalCurrency
		ON TransactionCurrency.Company = LocalCurrency.Company
			AND TransactionCurrency.BusinessUnit = LocalCurrency.BusinessUnit
			AND TransactionCurrency.ExpenseType = LocalCurrency.ExpenseType
			AND TransactionCurrency.Recorder = LocalCurrency.Recorder
			AND TransactionCurrency.SecondPeriod = LocalCurrency.SecondPeriod
			AND TransactionCurrency.MonthPeriod = LocalCurrency.MonthPeriod
			AND TransactionCurrency.ProfitLossCenter = LocalCurrency.ProfitLossCenter</query>
	</dataSet>
	<totalField>
		<dataPath>AmountLocal</dataPath>
		<expression>Sum(AmountLocal)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountTurnover</dataPath>
		<expression>Sum(AmountTurnover)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountWithTaxes</dataPath>
		<expression>Sum(AmountWithTaxes)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountWithTaxesLocal</dataPath>
		<expression>Sum(AmountWithTaxesLocal)</expression>
	</totalField>
