		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R6020B_BatchBalanceBalanceAndTurnovers.Recorder AS Recorder,
	R6020B_BatchBalanceBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R6020B_BatchBalanceBalanceAndTurnovers.Company AS Company,
	R6020B_BatchBalanceBalanceAndTurnovers.Store AS Store,
	R6020B_BatchBalanceBalanceAndTurnovers.LegalName,
	R6020B_BatchBalanceBalanceAndTurnovers.ItemKey AS ItemKey,
	R6020B_BatchBalanceBalanceAndTurnovers.ItemKey.Item AS Item,
	R6020B_BatchBalanceBalanceAndTurnovers.Batch AS Batch,
	R6020B_BatchBalanceBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R6020B_BatchBalanceBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R6020B_BatchBalanceBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R6020B_BatchBalanceBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalAmountOpeningBalance AS TotalAmountOpeningBalance,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalAmountReceipt AS TotalAmountReceipt,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalAmountExpense AS TotalAmountExpense,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalAmountClosingBalance AS TotalAmountClosingBalance,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalNetAmountOpeningBalance AS NetAmountOpeningBalance,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalNetAmountReceipt AS NetAmountReceipt,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalNetAmountExpense AS NetAmountExpense,
	R6020B_BatchBalanceBalanceAndTurnovers.TotalNetAmountClosingBalance AS NetAmountClosingBalance
FROM
	AccumulationRegister.R6020B_BatchBalance.BalanceAndTurnovers(,, Auto,,) AS R6020B_BatchBalanceBalanceAndTurnovers</query>
