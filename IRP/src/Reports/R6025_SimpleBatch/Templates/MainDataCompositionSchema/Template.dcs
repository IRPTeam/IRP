		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R6025B_SimpleBatchBalanceAndTurnovers.SimpleBatch AS SimpleBatch,
	R6025B_SimpleBatchBalanceAndTurnovers.QuantityOpeningBalance AS QuantityOpeningBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.QuantityTurnover AS QuantityTurnover,
	R6025B_SimpleBatchBalanceAndTurnovers.QuantityReceipt AS QuantityReceipt,
	R6025B_SimpleBatchBalanceAndTurnovers.QuantityExpense AS QuantityExpense,
	R6025B_SimpleBatchBalanceAndTurnovers.QuantityClosingBalance AS QuantityClosingBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.AmountTurnover AS AmountTurnover,
	R6025B_SimpleBatchBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	R6025B_SimpleBatchBalanceAndTurnovers.AmountExpense AS AmountExpense,
	R6025B_SimpleBatchBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalQuantityOpeningBalance AS FinalQuantityOpeningBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalQuantityTurnover AS FinalQuantityTurnover,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalQuantityReceipt AS FinalQuantityReceipt,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalQuantityExpense AS FinalQuantityExpense,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalQuantityClosingBalance AS FinalQuantityClosingBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalAmountOpeningBalance AS FinalAmountOpeningBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalAmountTurnover AS FinalAmountTurnover,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalAmountReceipt AS FinalAmountReceipt,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalAmountExpense AS FinalAmountExpense,
	R6025B_SimpleBatchBalanceAndTurnovers.FinalAmountClosingBalance AS FinalAmountClosingBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.DiffAmountOpeningBalance AS DiffAmountOpeningBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.DiffAmountTurnover AS DiffAmountTurnover,
	R6025B_SimpleBatchBalanceAndTurnovers.DiffAmountReceipt AS DiffAmountReceipt,
	R6025B_SimpleBatchBalanceAndTurnovers.DiffAmountExpense AS DiffAmountExpense,
	R6025B_SimpleBatchBalanceAndTurnovers.DiffAmountClosingBalance AS DiffAmountClosingBalance,
	R6025B_SimpleBatchBalanceAndTurnovers.Period AS Period,
	R6025B_SimpleBatchBalanceAndTurnovers.Recorder AS Recorder
FROM
	AccumulationRegister.R6025B_SimpleBatch.BalanceAndTurnovers(, , Recorder, , ) AS R6025B_SimpleBatchBalanceAndTurnovers</query>
