		<dataSource>DataSource1</dataSource>
		<query>SELECT
	R2001T_SalesTurnovers.Recorder AS Recorder,
	R2001T_SalesTurnovers.SecondPeriod AS SecondPeriod,
	R2001T_SalesTurnovers.Company AS Company,
	R2001T_SalesTurnovers.Invoice AS Invoice,
	R2001T_SalesTurnovers.ItemKey.Item AS Item,
	R2001T_SalesTurnovers.ItemKey AS ItemKey,
	R2001T_SalesTurnovers.QuantityTurnover AS QuantityTurnover,
	R2001T_SalesTurnovers.AmountTurnover AS SalesTotalAmount,
	R2001T_SalesTurnovers.NetAmountTurnover AS SalesNetAmount,
	0 AS CogsTotalAmount,
	0 AS CogsNetAmount,
	-R2001T_SalesTurnovers.QuantityTurnover AS QuantityCheck,
	R2001T_SalesTurnovers.AmountTurnover AS AmountRevenue,
	R2001T_SalesTurnovers.NetAmountTurnover AS NetAmountRevenue
FROM
	AccumulationRegister.R2001T_Sales.Turnovers(, , Auto, CurrencyMovementType.Type = VALUE(Enum.CurrencyType.Legal)) AS R2001T_SalesTurnovers

UNION ALL

SELECT
	R6060T_CostOfGoodsSoldTurnovers.Recorder,
	R6060T_CostOfGoodsSoldTurnovers.SecondPeriod,
	R6060T_CostOfGoodsSoldTurnovers.Company,
	R6060T_CostOfGoodsSoldTurnovers.SalesInvoice,
	R6060T_CostOfGoodsSoldTurnovers.ItemKey.Item,
	R6060T_CostOfGoodsSoldTurnovers.ItemKey,
	0,
	0,
	0,
	R6060T_CostOfGoodsSoldTurnovers.InvoiceAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.InvoiceTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.IndirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.IndirectCostTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraCostAmountByRatioTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraCostTaxAmountByRatioTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraDirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraDirectCostTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedCostTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedRevenueAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedRevenueTaxAmountTurnover,
	R6060T_CostOfGoodsSoldTurnovers.InvoiceAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.IndirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraCostAmountByRatioTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraDirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedRevenueAmountTurnover,
	R6060T_CostOfGoodsSoldTurnovers.QuantityTurnover,
	-1 * (R6060T_CostOfGoodsSoldTurnovers.InvoiceAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.InvoiceTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.IndirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.IndirectCostTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraCostAmountByRatioTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraCostTaxAmountByRatioTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraDirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraDirectCostTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedCostTaxAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedRevenueAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedRevenueTaxAmountTurnover),
	-1 * (R6060T_CostOfGoodsSoldTurnovers.InvoiceAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.IndirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraCostAmountByRatioTurnover + R6060T_CostOfGoodsSoldTurnovers.ExtraDirectCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedCostAmountTurnover + R6060T_CostOfGoodsSoldTurnovers.AllocatedRevenueAmountTurnover)
FROM
	AccumulationRegister.R6060T_CostOfGoodsSold.Turnovers(, , Auto, ) AS R6060T_CostOfGoodsSoldTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>AmountRevenue</dataPath>
		<expression>Sum(AmountRevenue)</expression>
	</totalField>
	<totalField>
		<dataPath>CogsNetAmount</dataPath>
		<expression>Sum(CogsNetAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>CogsTotalAmount</dataPath>
		<expression>Sum(CogsTotalAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>NetAmountRevenue</dataPath>
		<expression>Sum(NetAmountRevenue)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityCheck</dataPath>
		<expression>Sum(QuantityCheck)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityTurnover</dataPath>
		<expression>Sum(QuantityTurnover)</expression>
	</totalField>
	<totalField>
		<dataPath>SalesNetAmount</dataPath>
		<expression>Sum(SalesNetAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>SalesTotalAmount</dataPath>
		<expression>Sum(SalesTotalAmount)</expression>
	</totalField>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Begin of period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.StartDate</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>End of period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.EndDate</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>ReportPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Default</dcsset:name>
