		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R6510B_StockBalance.Company AS Company,
	R6510B_StockBalance.Store AS Store,
	R6510B_StockBalance.ItemKey.Item AS Item,
	R6510B_StockBalance.ItemKey AS ItemKey,
	R6510B_StockBalance.SerialLotNumber AS SerialLotNumber,
	R6510B_StockBalance.SourceOfOrigin AS SourceOfOrigin,
	R6510B_StockBalance.Basis AS Basis,
	
	R6510B_StockBalance.ActualQuantityOpeningBalance AS ActualQuantityOpeningBalance,
	R6510B_StockBalance.ActualQuantityReceipt AS ActualQuantityReceipt,
	R6510B_StockBalance.ActualQuantityExpense AS ActualQuantityExpense,
	R6510B_StockBalance.ActualQuantityClosingBalance AS ActualQuantityClosingBalance,
	
	R6510B_StockBalance.FreeQuantityOpeningBalance AS FreeQuantityOpeningBalance,
	R6510B_StockBalance.FreeQuantityReceipt AS FreeQuantityReceipt,
	R6510B_StockBalance.FreeQuantityExpense AS FreeQuantityExpense,
	R6510B_StockBalance.FreeQuantityClosingBalance AS FreeQuantityClosingBalance,
	
	R6510B_StockBalance.ReservationQuantityOpeningBalance AS ReservationQuantityOpeningBalance,
	R6510B_StockBalance.ReservationQuantityReceipt AS ReservationQuantityReceipt,
	R6510B_StockBalance.ReservationQuantityExpense AS ReservationQuantityExpense,
	R6510B_StockBalance.ReservationQuantityClosingBalance AS ReservationQuantityClosingBalance,
	
	R6510B_StockBalance.TransitIncomingQuantityOpeningBalance AS TransitIncomingQuantityOpeningBalance,
	R6510B_StockBalance.TransitIncomingQuantityReceipt AS TransitIncomingQuantityReceipt,
	R6510B_StockBalance.TransitIncomingQuantityExpense AS TransitIncomingQuantityExpense,
	R6510B_StockBalance.TransitIncomingQuantityClosingBalance AS TransitIncomingQuantityClosingBalance,
	
	R6510B_StockBalance.TransitOutgoingQuantityOpeningBalance AS TransitOutgoingQuantityOpeningBalance,
	R6510B_StockBalance.TransitOutgoingQuantityReceipt AS TransitOutgoingQuantityReceipt,
	R6510B_StockBalance.TransitOutgoingQuantityExpense AS TransitOutgoingQuantityExpense,
	R6510B_StockBalance.TransitOutgoingQuantityClosingBalance AS TransitOutgoingQuantityClosingBalance,
	
	R6510B_StockBalance.InventoryQuantityOpeningBalance AS InventoryQuantityOpeningBalance,
	R6510B_StockBalance.InventoryQuantityReceipt AS InventoryQuantityReceipt,
	R6510B_StockBalance.InventoryQuantityExpense AS InventoryQuantityExpense,
	R6510B_StockBalance.InventoryQuantityClosingBalance AS InventoryQuantityClosingBalance,
	
	R6510B_StockBalance.PreliminaryQuantityOpeningBalance AS PreliminaryQuantityOpeningBalance,
	R6510B_StockBalance.PreliminaryQuantityReceipt AS PreliminaryQuantityReceipt,
	R6510B_StockBalance.PreliminaryQuantityExpense AS PreliminaryQuantityExpense,
	R6510B_StockBalance.PreliminaryQuantityClosingBalance AS PreliminaryQuantityClosingBalance,
	
	R6510B_StockBalance.Recorder AS Recorder,
	R6510B_StockBalance.SecondPeriod AS SecondPeriod
	
FROM
	AccumulationRegister.R6510B_StockBalance.BalanceAndTurnovers(, , Auto, , ) AS R6510B_StockBalance</query>
	</dataSet>
