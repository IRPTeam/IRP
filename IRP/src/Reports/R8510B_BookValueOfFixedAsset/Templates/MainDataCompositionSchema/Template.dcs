		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Reg.Recorder,
	Reg.SecondPeriod,
	Reg.Company,
	Reg.Branch,
	Reg.ProfitLossCenter,
	Reg.FixedAsset,
	Reg.LedgerType,
	Reg.Schedule,
	Reg.Currency,
	Reg.CurrencyMovementType,
	Reg.TransactionCurrency,
	Reg.AmountOpeningBalance,
	Reg.AmountReceipt,
	Reg.AmountExpense,
	Reg.AmountClosingBalance
FROM
	AccumulationRegister.R8510B_BookValueOfFixedAsset.BalanceAndTurnovers({&amp;StartDate}, {&amp;EndDate}, Auto,,) AS Reg</query>
	</dataSet>
	<totalField>
		<dataPath>AmountOpeningBalance</dataPath>
		<expression>Sum(AmountOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountReceipt</dataPath>
		<expression>Sum(AmountReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountExpense</dataPath>
		<expression>Sum(AmountExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountClosingBalance</dataPath>
		<expression>Sum(AmountClosingBalance)</expression>
	</totalField>
