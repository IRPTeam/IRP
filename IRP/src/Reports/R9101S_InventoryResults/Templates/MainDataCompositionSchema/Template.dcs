		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PhysicalInventoryItemList.Ref.Store AS Store,
	PhysicalInventoryItemList.ItemKey AS ItemKey,
	PhysicalInventoryItemList.ExpCount AS ExpCount,
	PhysicalInventoryItemList.PhysCount AS PhysCount,
	PhysicalInventoryItemList.Difference AS Difference
INTO Inventory
FROM
	Document.PhysicalInventory.ItemList AS PhysicalInventoryItemList
WHERE
	PhysicalInventoryItemList.Ref IN(&amp;PhysicalInventory)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	R4051T_StockAdjustmentAsWriteOffTurnovers.Store AS Store,
	R4051T_StockAdjustmentAsWriteOffTurnovers.ItemKey AS ItemKey,
	R4051T_StockAdjustmentAsWriteOffTurnovers.QuantityTurnover AS Quantity
INTO StockAdjustmentAsWriteOff
FROM
	AccumulationRegister.R4051T_StockAdjustmentAsWriteOff.Turnovers(
			,
			,
			,
			Store IN
				(SELECT DISTINCT
					Inventory.Store AS Store
				FROM
					Inventory AS Inventory)) AS R4051T_StockAdjustmentAsWriteOffTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	R4052T_StockAdjustmentAsSurplusTurnovers.Store AS Store,
	R4052T_StockAdjustmentAsSurplusTurnovers.ItemKey AS ItemKey,
	R4052T_StockAdjustmentAsSurplusTurnovers.QuantityTurnover AS Quantity
INTO StockAdjustmentAsSurplusTurnovers
FROM
	AccumulationRegister.R4052T_StockAdjustmentAsSurplus.Turnovers(
			,
			,
			,
			Store IN
				(SELECT DISTINCT
					Inventory.Store AS Store
				FROM
					Inventory AS Inventory)) AS R4052T_StockAdjustmentAsSurplusTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Inventory.Store AS Store,
	Inventory.ItemKey.Item AS Item,
	Inventory.ItemKey AS ItemKey,
	Inventory.ExpCount AS ExpCount,
	Inventory.PhysCount AS PhysCount,
	Inventory.Difference AS Difference,
	0 AS StockAdjustmentAsWriteOff,
	0 AS StockAdjustmentAsSurplus
INTO ResultTable
FROM
	Inventory AS Inventory

UNION ALL

SELECT
	StockAdjustmentAsWriteOff.Store,
	StockAdjustmentAsWriteOff.ItemKey.Item,
	StockAdjustmentAsWriteOff.ItemKey,
	0,
	0,
	0,
	StockAdjustmentAsWriteOff.Quantity,
	0
FROM
	StockAdjustmentAsWriteOff AS StockAdjustmentAsWriteOff

UNION ALL

SELECT
	StockAdjustmentAsSurplusTurnovers.Store,
	StockAdjustmentAsSurplusTurnovers.ItemKey.Item,
	StockAdjustmentAsSurplusTurnovers.ItemKey,
	0,
	0,
	0,
	0,
	StockAdjustmentAsSurplusTurnovers.Quantity
FROM
	StockAdjustmentAsSurplusTurnovers AS StockAdjustmentAsSurplusTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ResultTable.Store AS Store,
	ResultTable.Item AS Item,
	ResultTable.ItemKey AS ItemKey,
	SUM(ResultTable.ExpCount) AS ExpCount,
	SUM(ResultTable.PhysCount) AS PhysCount,
	SUM(ResultTable.Difference) AS Difference,
	SUM(ResultTable.StockAdjustmentAsWriteOff) AS StockAdjustmentAsWriteOff,
	SUM(ResultTable.StockAdjustmentAsSurplus) AS StockAdjustmentAsSurplus,
	SUM(ResultTable.StockAdjustmentAsSurplus - ResultTable.StockAdjustmentAsWriteOff) AS StokAdjustmentTotal,
	PricesByItemKeysSliceLast.Price AS Price,
	ResultTable.ExpCount * PricesByItemKeysSliceLast.Price AS ExpCountAmount,
	ResultTable.PhysCount * PricesByItemKeysSliceLast.Price AS PhysCountAmount,
	ResultTable.Difference * PricesByItemKeysSliceLast.Price AS DifferenceAmount,
	(ResultTable.StockAdjustmentAsSurplus - ResultTable.StockAdjustmentAsWriteOff) * PricesByItemKeysSliceLast.Price AS StokAdjustmentTotalAmount
FROM
	ResultTable AS ResultTable
		LEFT JOIN InformationRegister.PricesByItemKeys.SliceLast(, PriceType = &amp;PriceTypeCost) AS PricesByItemKeysSliceLast
		ON ResultTable.ItemKey = PricesByItemKeysSliceLast.ItemKey

GROUP BY
	ResultTable.Item,
	ResultTable.ItemKey,
	ResultTable.Store,
	PricesByItemKeysSliceLast.Price,
	ResultTable.ExpCount * PricesByItemKeysSliceLast.Price,
	ResultTable.PhysCount * PricesByItemKeysSliceLast.Price,
	ResultTable.Difference * PricesByItemKeysSliceLast.Price,
	(ResultTable.StockAdjustmentAsSurplus - ResultTable.StockAdjustmentAsWriteOff) * PricesByItemKeysSliceLast.Price</query>
	</dataSet>
	<totalField>
		<dataPath>Difference</dataPath>
		<expression>Sum(Difference)</expression>
	</totalField>
	<totalField>
		<dataPath>DifferenceAmount</dataPath>
		<expression>Sum(DifferenceAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpCount</dataPath>
		<expression>Sum(ExpCount)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpCountAmount</dataPath>
		<expression>Sum(ExpCountAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>PhysCount</dataPath>
		<expression>Sum(PhysCount)</expression>
	</totalField>
	<totalField>
		<dataPath>PhysCountAmount</dataPath>
		<expression>Sum(PhysCountAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>StockAdjustmentAsSurplus</dataPath>
		<expression>Sum(StockAdjustmentAsSurplus)</expression>
	</totalField>
	<totalField>
		<dataPath>StockAdjustmentAsWriteOff</dataPath>
		<expression>Sum(StockAdjustmentAsWriteOff)</expression>
	</totalField>
	<totalField>
		<dataPath>StokAdjustmentTotal</dataPath>
		<expression>Sum(StokAdjustmentTotal)</expression>
	</totalField>
	<totalField>
		<dataPath>StokAdjustmentTotalAmount</dataPath>
		<expression>Sum(StokAdjustmentTotalAmount)</expression>
	</totalField>
	<parameter>
		<name>PhysicalInventory</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Sayım fişi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Инвентаризация товаров</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Physical inventory</v8:content>
			</v8:item>
		</title>
		<value xsi:type="xs:string"/>
		<useRestriction>false</useRestriction>
		<valueListAllowed>true</valueListAllowed>
	</parameter>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Begin of period</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.StartDate</expression>
