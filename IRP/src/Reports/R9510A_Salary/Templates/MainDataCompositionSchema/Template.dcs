		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	R9510B_SalaryPaymentBalanceAndTurnovers.Company AS Company,
	R9510B_SalaryPaymentBalanceAndTurnovers.Branch AS Branch,
	R9510B_SalaryPaymentBalanceAndTurnovers.Employee AS Employee,
	R9510B_SalaryPaymentBalanceAndTurnovers.Currency AS Currency,
	R9510B_SalaryPaymentBalanceAndTurnovers.AmountOpeningBalance AS AmountOpeningBalance,
	R9510B_SalaryPaymentBalanceAndTurnovers.AmountReceipt AS AmountReceipt,
	R9510B_SalaryPaymentBalanceAndTurnovers.AmountExpense AS AmountExpense,
	R9510B_SalaryPaymentBalanceAndTurnovers.AmountClosingBalance AS AmountClosingBalance,
	R9510B_SalaryPaymentBalanceAndTurnovers.Recorder AS Recorder,
	R9510B_SalaryPaymentBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	R9510B_SalaryPaymentBalanceAndTurnovers.PaymentPeriod AS PaymentPeriod,
	R9510B_SalaryPaymentBalanceAndTurnovers.CalculationType AS CalculationType
FROM
	AccumulationRegister.R9510B_SalaryPayment.BalanceAndTurnovers(, , Auto, , CurrencyMovementType.Type = VALUE(Enum.CurrencyType.EmptyRef)) AS R9510B_SalaryPaymentBalanceAndTurnovers</query>
	</dataSet>
