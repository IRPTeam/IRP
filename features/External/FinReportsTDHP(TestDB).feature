		Variant = Catalogs.LedgerTypeVariants.GetRef(New UUID("3b745785-58f4-5afd-9395-2aca502e0baa"));
		Selection = ChartsOfAccounts.Basic.Select();
		Updated = 0;
		While Selection.Next() Do
			If Selection.LedgerTypeVariant <> Variant Then
				Continue;
			EndIf;
			Obj = Selection.Ref.GetObject();
			Changed = False;
			For Each Row In Obj.ExtDimensionTypes Do
				If Not Row.Amount Then
					Row.Amount = True;
					Changed = True;
				EndIf;
				If Obj.Currency And Not Row.Currency Then
					Row.Currency = True;
					Changed = True;
				EndIf;
				If Obj.Quantity And Not Row.Quantity Then
					Row.Quantity = True;
					Changed = True;
				EndIf;
			EndDo;
			If Changed Then
				Obj.Write();
				Updated = Updated + 1;
			EndIf;
		EndDo;
		Message("TDHP accounts with ext dimension accounting flags set: " + Updated);
